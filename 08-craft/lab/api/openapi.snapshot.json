    "/orders/{order_id}": {
      "delete": {
        "description": "Idempotent by construction: 204 whether or not the row existed.\n\nThe read-check-delete version would need a 404 branch in every caller AND\nwould race two concurrent deletes into one spurious error. One statement\nwith a WHERE clause removes both problems, and the rowcount is available if\nanyone ever needs to know which of the two happened.",
        "operationId": "delete_order",
        "parameters": [
          {
            "in": "path",
            "name": "order_id",
            "required": true,
            "schema": {
              "title": "Order Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "deleted, or already absent"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Delete Order",
        "tags": [
          "orders"
        ]
      },
